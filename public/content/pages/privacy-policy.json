    {
      "label": "You have the right to request access to your personal data, request…",
      "cmsId": "privacy-policy-085",
      "html": "You have the right to request access to your personal data, request corrections to your personal data, request deletion of your personal data, and opt-out of marketing communications."
    },
    {
